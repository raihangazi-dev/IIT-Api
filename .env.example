# ── Database ─────────────────────────────────────────────────────────────────
# Get a free PostgreSQL URL from https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── App ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
# Your frontend deployment URL (used for CORS)
WEB_APP_URL=https://your-frontend.vercel.app

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ── Email ────────────────────────────────────────────────────────────────────
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="IIT Alumni <no-reply@yourdomain.com>"
